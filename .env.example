OPENAI_API_KEY=dummy
MODEL_1=Qwen/Qwen2.5-14B-Instruct
MODEL_2=mistralai/Mistral-Nemo-Instruct-2407
MODEL_1_FALLBACK=
MODEL_2_FALLBACK=
MODEL_1_PATH=
MODEL_2_PATH=
MODEL_1_FALLBACK_PATH=
MODEL_2_FALLBACK_PATH=
PRELOAD_MODELS=false

# Docker Compose host mounts
HOST_DATA_DIR=./data
HOST_OUTPUT_DIR=./output
HOST_MODEL_STORE_DIR=./models
HOST_MODELS_CACHE_DIR=./models-cache

INPUT_CSV=data/papers.csv
RULES_JSON=data/rules.json
OUTPUT_DIR=output
BATCH_SIZE=20
EVAL_PROGRESS=true

# Local vLLM orchestrator settings
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_HOST=0.0.0.0
VLLM_PORT=8000
VLLM_STARTUP_TIMEOUT=600
VLLM_GPU_MEMORY_UTILIZATION=0.9
VLLM_MAX_MODEL_LEN=8192
VLLM_DTYPE=bfloat16
VLLM_PRECISION_POLICY=auto
VLLM_FALLBACK_QUANTIZATION=awq
VLLM_STREAM_LOGS=true
MODEL_STORE_DIR=/models
MODEL_CACHE_DIR=/models-cache
PREFETCH_USE_HF_CACHE=false
LOCAL_ONLY=true
CONTAINER_TASK=evaluate

# Pipeline behavior
RESUME=false
